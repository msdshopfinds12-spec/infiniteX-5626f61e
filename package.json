{
  "name": "bolt-ultimate-ai-engineering-os",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc -b --noEmit",
    "test:edge-worker-security": "node --test supabase/functions/_shared/worker-security.test.mjs",
    "test:edge-function-cors": "node --experimental-strip-types --test supabase/functions/_shared/cors.test.mjs",
    "test:edge-function-security": "npm run test:edge-function-cors && npm run test:edge-worker-security",
    "test:workflow-retry-policy": "node --test supabase/functions/_shared/workflow-retry-policy.test.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^0.456.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
