{
  "name": "infinitex-engineering-control-plane",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "npm audit --audit-level=high",
    "typecheck:server": "tsc --noEmit --target ES2022 --module ESNext --moduleResolution bundler --lib ES2023,DOM --strict --skipLibCheck api/ai.ts server/ai-gateway/*.ts server/agent-adapters/*.ts"
  },
  "dependencies": {
    "lucide-react": "^0.456.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.6.3",
    "vite": "^6.4.6",
    "vitest": "^5.1.0"
  }
}
