{
  "name": "bolt-ultimate-ai-engineering-os",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "node --test",
    "test:e2e": "playwright test",
    "check:ci-policy": "node .github/scripts/verify-workflow-policy.mjs",
    "test:ci-policy": "node --test .github/scripts/verify-workflow-policy.test.mjs",
    "check:browser-boundary": "node .github/scripts/verify-browser-boundary.mjs",
    "test:browser-boundary": "node --test .github/scripts/verify-browser-boundary.test.mjs",
    "check:edge-function-security": "node .github/scripts/verify-edge-function-security.mjs",
    "test:edge-function-cors": "node --experimental-strip-types --test supabase/functions/_shared/cors.test.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^0.456.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "^5.6.3",
    "vite": "8.3.7",
    "yaml": "2.9.0"
  }
}
