{
  "name": "infinitex-workspace",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "node --experimental-strip-types --test",
    "test:edge-worker-security": "node --test supabase/functions/_shared/worker-security.test.mjs",
    "test:edge-function-cors": "node --experimental-strip-types --test supabase/functions/_shared/cors.test.mjs",
    "test:edge-function-security": "npm run test:edge-function-cors && npm run test:edge-worker-security",
    "test:worker-http-boundary": "node --test tests/workers/worker-auth-boundary.test.mjs",
    "test:workers": "node --experimental-strip-types --test tests/workers",
    "verify:phase-73c": "node scripts/verify-phase-73c-provenance.mjs",
    "verify:phase-73d": "node scripts/verify-phase-73d-read-only.mjs",
    "test:worker-runtime-parity": "node --test tests/workers/worker-runtime-parity.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.2",
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^0.456.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.6.3",
    "vite": "^8.3.8"
  }
}
