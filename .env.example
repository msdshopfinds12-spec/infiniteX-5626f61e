# Required trusted identity-provider configuration; replace all placeholders locally.
INFINITEGX_ENVIRONMENT=development
INFINITEGX_JWT_JWKS_URL=https://YOUR-TRUSTED-ISSUER/.well-known/jwks.json
INFINITEGX_JWT_ISSUER=https://YOUR-TRUSTED-ISSUER/
INFINITEGX_JWT_AUDIENCE=infinitegx-api
INFINITEGX_OWNER_SUBJECT=SET_TO_THE_OWNER_SUBJECT_FROM_THE_IDENTITY_PROVIDER
INFINITEGX_OWNER_TENANT_ID=11111111-1111-4111-8111-111111111111

# Local database only; use a private secret in your local environment.
INFINITEGX_DATABASE_URL=postgresql+psycopg://infinitegx7:change-me@localhost:5432/infinitegx7
POSTGRES_DB=infinitegx7
POSTGRES_USER=infinitegx7
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
